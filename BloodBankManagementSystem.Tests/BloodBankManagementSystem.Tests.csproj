<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\BloodBankManagementSystem\Models\*.cs" Link="Models\%(FileName)%(Extension)" />
    <Compile Include="..\BloodBankManagementSystem\Data\*.cs" Link="Data\%(FileName)%(Extension)" />
    <Compile Include="..\BloodBankManagementSystem\Services\*.cs" Link="Services\%(FileName)%(Extension)" />
    <Compile Include="..\BloodBankManagementSystem\Helpers\ValidationHelper.cs" Link="Helpers\%(FileName)%(Extension)" />
  </ItemGroup>

</Project>
